        "jsonBody": "={{ JSON.stringify({ kind: '지시', title: $json.date + ' 일마감을 보내 주세요', body: '어제 영업 마감이 본사에 들어오지 않았습니다. POS에서 일마감을 진행하고, 이미 했다면 POS 연결 상태(보내기 대기)를 확인해 주세요.', important: true, needsReply: true, dueDate: $json.today, storeNos: [$json.storeNo], refKey: $json.refKey }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "cafeonErpKey0001",
          "name": "ERP 자동화 키"
        }
      },
      "onError": "continueRegularOutput"
    }
