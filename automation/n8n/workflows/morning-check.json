    {
      "id": "e4e1a3b8-c178-414b-a96d-5d18dbb9759d",
      "name": "마감 요청 대상",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "jsCode": "const won = (n) => Math.round(Number(n) || 0).toLocaleString('ko-KR') + '원';\n// HTTP 노드가 '오류여도 계속'으로 넘긴 응답에서 ERP 오류 메시지 꺼내기\nconst errText = (r) => {\n  const e = r && r.error;\n  if (!e) return null;\n  try { const b = typeof e.description === 'string' ? JSON.parse(e.description) : null; if (b && b.message) return b.message; } catch (x) {}\n  return e.message || JSON.stringify(e);\n};\n\nconst s = $('점검 정리').first().json;\nreturn s.notify.map((n) => ({ json: { ...n, date: s.date, today: s.today } }));\n"
      }
    },
    {
      "id": "90457e87-7a41-44ff-a0da-420a651b5298",
