# 이 파일을 local.properties로 복사하고 값을 채운다 (local.properties는 깃에 올라가지 않는다)
# 로그인 토큰 서명 키: 64자 이상 임의 문자열
jwt.secret=
# 홈 화면 뉴스 (네이버 검색 API) · 날씨 (OpenWeatherMap). 비워 두면 그 칸만 빈다
naver.client-id=
naver.client-secret=
weather.api-key=
# 본사 자동화 (n8n). 셋 다 비워 두면 자동화 연동이 꺼진다
#  api-key: n8n이 ERP API를 부를 때 쓰는 키 (X-Automation-Key 헤더)
#  webhook-url: ERP 이벤트(발주 요청 · 일마감)를 받을 n8n 웹훅 주소
#  webhook-secret: 웹훅 서명(HMAC-SHA256) 키. n8n의 ERP_WEBHOOK_SECRET과 같은 값
automation.api-key=
automation.webhook-url=http://localhost:5678/webhook/erp-events
automation.webhook-secret=
